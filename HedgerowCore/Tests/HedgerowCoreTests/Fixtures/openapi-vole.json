{
  "openapi": "3.1.0",
  "info": {
    "title": "Vigilant Vole API",
    "version": "0.14.0",
    "description": "REST API for Vigilant Vole. Authenticate with `Authorization: Bearer vv_…` (create tokens under Settings → API tokens). Read-only tokens act as viewers. Errors use `{\"error\": {\"code\", \"message\", \"fields\"}}`; lists use `?limit=&cursor=` and return `next_cursor`."
  },
  "servers": [{ "url": "https://vole.example.com" }],
  "tags": [{ "name": "Monitors" }, { "name": "Incidents" }],
  "paths": {
    "/api/v1/monitors": {
      "get": {
        "tags": ["Monitors"],
        "summary": "List monitors",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/incidents": {
      "get": {
        "tags": ["Incidents"],
        "summary": "List incidents",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "API token (vv_…)" },
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "vv_session" }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "example": { "error": { "code": "unauthorized", "message": "Missing or invalid token", "fields": [] } }
          }
        }
      }
    }
  }
}
