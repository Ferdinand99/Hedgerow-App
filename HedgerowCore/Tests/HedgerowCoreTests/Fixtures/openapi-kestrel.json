{
  "openapi": "3.1.0",
  "info": {
    "title": "Keen Kestrel API",
    "version": "0.5.0",
    "description": "REST API for Keen Kestrel. Authenticate with `Authorization: Bearer kk_…` (create tokens under Settings → API tokens). Read-only tokens act as viewers. Errors use `{\"error\": {\"code\", \"message\", \"fields\"}}`; lists use `?limit=&cursor=` and return `next_cursor`."
  },
  "servers": [{ "url": "https://kestrel.example.com" }],
  "tags": [{ "name": "Projects" }, { "name": "Issues" }],
  "paths": {
    "/api/v1/projects": {
      "get": {
        "tags": ["Projects"],
        "summary": "List projects",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/issues": {
      "get": {
        "tags": ["Issues"],
        "summary": "List issues",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "API token (kk_…)" },
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "kk_session" }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "example": { "error": { "code": "unauthorized", "message": "Missing or invalid token", "fields": [] } }
          }
        }
      }
    }
  }
}
